		{"id":"DIG_MCU","type":"text","x":-400,"y":-700,"width":300,"height":200,"text":"**STM32F746 (MCU)**\n[[05_Firmware_MCU]]\n*Control Plane*\nManages out-of-band config, clocks, bias, and thermal safety.","color":"4"},
		{"id":"DIG_FPGA","type":"text","x":100,"y":-700,"width":300,"height":200,"text":"**XC7A50T (FPGA)**\n[[04_Firmware_FPGA]]\n*Data Plane*\nExecutes DSP pipeline, radar timing, and fast ADC/DAC capture.","color":"1"},
		{"id":"DIG_FT","type":"text","x":-150,"y":-400,"width":300,"height":100,"text":"**FT2232H (USB Bridge)**\n[[04b_USB_Interface]]\nBridges FPGA high-speed FIFO to USB.","color":"1"},
