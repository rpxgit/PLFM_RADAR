		{"id":"HOST_PC","type":"text","x":1000,"y":-700,"width":250,"height":200,"text":"**Host PC (Python)**\n[[06_Software_GUI]]\n[[07_Communication_Protocols]]\nradar_protocol.py parses FT2232H datastream.","color":"6"},
		{"id":"HOST_GUI","type":"text","x":1000,"y":-400,"width":250,"height":150,"text":"**PyQt6 GUI**\nUser Visualization (FFT / Target Range), Configuration parameters.","color":"6"},
		{"id":"RF_ADF","type":"text","x":-1300,"y":250,"width":250,"height":150,"text":"**ADF4382 (Synthesizer)**\n[[03c_Frequency_Synthesizer_Board]]\nGenerates 10.5 GHz LFM Chirp LO.","color":"2"},
		{"id":"RF_ADAR","type":"text","x":-900,"y":250,"width":250,"height":150,"text":"**ADAR1000 (Beamformer)**\n[[05d_Beamformer_ADAR1000]]\nPhase/Gain control.","color":"2"},
		{"id":"RF_PA","type":"text","x":-500,"y":250,"width":250,"height":150,"text":"**QPA2962 (GaN PA)**\n[[03d_Power_Amplifier_Board]]\n10W RF Amplification.","color":"2"},
		{"id":"RF_ANT_TX","type":"text","x":-100,"y":250,"width":200,"height":150,"text":"**TX Antenna**\n[[03e_Antenna_Array]]\nNexus (Patch) or Ext (Waveguide).","color":"2"},
		{"id":"RF_TGT","type":"text","x":300,"y":250,"width":200,"height":400,"text":"**TARGET**\n(Propagation)"},
		{"id":"RF_ANT_RX","type":"text","x":700,"y":250,"width":200,"height":150,"text":"**RX Antenna**\nReceives echo.","color":"2"},
		{"id":"RF_RX_MIX","type":"text","x":700,"y":450,"width":200,"height":150,"text":"**Downconversion**\nMixes RF with LO.","color":"2"},
